{
    "version": 8,
    "configurePresets": [
        {
            "name": "default",
            "displayName": "Qt MinGW",
            "description": "Uses QT_ROOT, MINGW_ROOT, and NINJA_ROOT environment variables",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "cacheVariables": {
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}",
                "CMAKE_PREFIX_PATH": "$env{QT_ROOT}",
                "CMAKE_CXX_COMPILER": "$env{MINGW_ROOT}/bin/g++.exe",
                "CMAKE_MAKE_PROGRAM": "$env{NINJA_ROOT}/ninja.exe",
                "CMAKE_BUILD_TYPE": "Debug"
            }
        }
    ]
}